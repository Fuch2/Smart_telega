[Unit]
Description=SmartCart Git pull, Docker build, and restart
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__SMARTCART_DIR__
Environment=SMARTCART_DIR=__SMARTCART_DIR__
Environment=DISPLAY=:0
Environment=QT_QPA_PLATFORM=xcb
Environment=QT_X11_NO_MITSHM=1
ExecStart=__SMARTCART_DIR__/deploy/rpi/autodeploy.sh
TimeoutStartSec=0
