[Unit]
Description=SmartCart Qt UI
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
WorkingDirectory=__SMARTCART_ROOT__/shared
Environment=DISPLAY=__DISPLAY__
Environment=XAUTHORITY=__XAUTHORITY__
Environment=QT_QPA_PLATFORM=xcb
Environment=QT_X11_NO_MITSHM=1
ExecStart=__SMARTCART_ROOT__/current/smart_cart_ui
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
