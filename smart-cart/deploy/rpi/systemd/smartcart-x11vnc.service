[Unit]
Description=SmartCart VNC Server (x11vnc :99)
After=smartcart-xvfb.service
Requires=smartcart-xvfb.service

[Service]
Type=simple
# Ждём появления лок-файла дисплея прежде чем цепляться к нему
ExecStartPre=/bin/bash -c 'until [ -e /tmp/.X99-lock ]; do sleep 0.2; done'
ExecStart=/usr/bin/x11vnc -display :99 -nopw -listen localhost -forever -shared -noxdamage -quiet
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
