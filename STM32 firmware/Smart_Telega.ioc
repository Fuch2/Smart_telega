# ── USART1: протокол команд (PA9=TX, PA10=RX) ────────────────────────────────
PA9.Locked=true
PA9.Signal=USART1_TX

PA10.Locked=true
PA10.Signal=USART1_RX

USART1.BaudRate=115200
USART1.IPParameters=VirtualMode-Asynchronous,BaudRate,WordLength,Parity,StopBits
USART1.Parity=UART_PARITY_NONE
USART1.StopBits=UART_STOPBITS_1
USART1.VirtualMode-Asynchronous=VM_ASYNC
USART1.WordLength=UART_WORDLENGTH_8B

# ── TIM3 CH3 PWM + DMA → WS2812 (PA8 = TIM1_CH1 alt или PB0 alt) ────────────
# Используем TIM3_CH3 → PB0 (AF remapped) для WS2812 PWM
# 72MHz / 90 = 800kHz (период WS2812)
# CCR для bit=1: ~56 (62.5%), bit=0: ~28 (31.25%)
PA8.Locked=true
PA8.Signal=TIM1_CH1

TIM3.Channel-PWM\ Generation3\ CH3=TIM_CHANNEL_3
TIM3.IPParameters=Channel-PWM\ Generation3\ CH3,Period,Prescaler,ClockDivision,CounterMode
TIM3.Period=89
TIM3.Prescaler=0
TIM3.ClockDivision=TIM_CLOCKDIVISION_DIV1
TIM3.CounterMode=TIM_COUNTERMODE_UP

# ── DMA для TIM3 CH3 (WS2812 burst) ─────────────────────────────────────────
DMA.TIM3_CH3=1,DMA1_Channel2,DMA_REQUEST_0,DMA_PERIPH_TO_MEMORY
DMA.IPParameters=TIM3_CH3

